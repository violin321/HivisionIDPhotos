# HivisionIDPhotos deployment environment template
# Copy values into your runtime/PM2 environment. Never commit real secrets.

# FastAPI / app auth
IDPHOTO_APP_USERNAME=
IDPHOTO_APP_PASSWORD=
IDPHOTO_APP_SESSION_SECRET=<set-in-runtime-only>
IDPHOTO_DOWNLOAD_SIGNING_SECRET=<set-in-runtime-only>

# Web v2
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_USE_MOCK_API=false

# AI Pro provider (optional; missing key keeps no_credentials/mock fallback available)
AI_PRO_PROVIDER=metapi
GPT_IMAGE_API_BASE=http://127.0.0.1:4000/v1
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_API_KEY=<set-in-runtime-only>
AI_PRO_TIMEOUT_SECONDS=45
AI_PRO_RETRY_COUNT=0
